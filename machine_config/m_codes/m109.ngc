; m109.ngc - Marlin M109 P<°C> Q<extruder>: hotend target, wait.
; LinuxCNC REMAP (machine.ini [RS274NGC]); see .agent/component/gcode_upload.md.
o<m109> sub
#<temp> = 0
o<temp_p> if [EXISTS[#<p>]]
  #<temp> = #<p>
o<temp_p> endif
#<heater> = 0
o<heater_q> if [EXISTS[#<q>]]
  #<heater> = #<q>
o<heater_q> endif
M181 P#<temp> Q#<heater>
o<m109> endsub
M2
