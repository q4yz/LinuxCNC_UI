; m106.ngc - Marlin M106 P<0-255> Q<fan>: part fan speed.
; LinuxCNC REMAP (machine.ini [RS274NGC]); see .agent/component/gcode_upload.md.
o<m106> sub
#<speed> = 255
o<speed_p> if [EXISTS[#<p>]]
  #<speed> = #<p>
o<speed_p> endif
#<fan> = 0
o<fan_q> if [EXISTS[#<q>]]
  #<fan> = #<q>
o<fan_q> endif
M182 P#<speed> Q#<fan>
o<m106> endsub
M2
