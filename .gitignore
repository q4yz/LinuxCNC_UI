*.pyc
__pycache__/

# LinuxCNC artifacts
cnc_ini/*.var
cnc_ini/*.bak
cnc_ini/*.txt

# Logs & Databases
*.db
*.log
log/

# Backend virtual environment
backend/venv/
backend/.env

# Frontend build & dependencies
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
# Auto-generated artifacts (OpenAPI client + its download cache).
# Anything under `generated/` is produced by `npm run generate-api`
# and must never be committed. The README is the one exception — it is
# the in-repo marker explaining the rule, so it stays tracked.
frontend/generated/*
!frontend/generated/README.md

# Old legacy ignores (safe to keep)
templates/gb_*
static/examples/*
static/gcodes/*
build/
img/
