O<probe_circle_inside> sub
(Call: O<probe_circle_inside> call [Probe Dia] [Max Radius] [Fast Feed])
#<probe_dia> = #1
#<max_rad> = #2
#<fast_feed> = #3
#<slow_feed> = [#<fast_feed> / 10.0]

(Save starting WORK coordinates)
#<start_x> = #<_x>
#<start_y> = #<_y>

G40 G49

(--- PROBE X+ ---)
G91 G38.2 X#<max_rad> F#<fast_feed>
O101 if [#5070 EQ 0]
    (MSG, X+ Probe failed to hit wall!)
    G90
    M2
O101 endif
G91 G0 X-1.0
G91 G38.2 X2.0 F#<slow_feed>
#<x_plus> = #5061

(Return X to start using true WORK coordinates)
G90 G0 X#<start_x>

(--- PROBE X- ---)
G91 G38.2 X-[#<max_rad>] F#<fast_feed>
O102 if [#5070 EQ 0]
    (MSG, X- Probe failed to hit wall!)
    G90
    M2
O102 endif
G91 G0 X1.0
G91 G38.2 X-2.0 F#<slow_feed>
#<x_minus> = #5061

(Calculate X Center in WORK coords)
#<center_x> = [[#<x_plus> + #<x_minus>] / 2.0]

(Move X to Center using WORK coords - removed G53)
G90 G0 X#<center_x>

(--- PROBE Y+ ---)
G91 G38.2 Y#<max_rad> F#<fast_feed>
O103 if [#5070 EQ 0]
    (MSG, Y+ Probe failed to hit wall!)
    G90
    M2
O103 endif
G91 G0 Y-1.0
G91 G38.2 Y2.0 F#<slow_feed>
#<y_plus> = #5062

(Return Y to start using true WORK coordinates)
G90 G0 Y#<start_y>

(--- PROBE Y- ---)
G91 G38.2 Y-[#<max_rad>] F#<fast_feed>
O104 if [#5070 EQ 0]
    (MSG, Y- Probe failed to hit wall!)
    G90
    M2
O104 endif
G91 G0 Y1.0
G91 G38.2 Y-2.0 F#<slow_feed>
#<y_minus> = #5062

(Calculate Y Center in WORK coords)
#<center_y> = [[#<y_plus> + #<y_minus>] / 2.0]

(Move Y to Center using WORK coords - removed G53)
G90 G0 Y#<center_y>

(Now that probe is sitting at true physical center, set WCS!)
G10 L20 P0 X0 Y0

(Calculate and print diameter)
#<diameter> = [[#<y_plus> - #<y_minus>] + #<probe_dia>]
(MSG, Bore Diameter is: #<diameter>)

G90 (Return to absolute mode safely)
O<probe_circle_inside> endsub
M2