{
  "include": [
    "tests/**/*.ts",
    "tests/**/*.mjs"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",

    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // Tests are runtime-only — they run via `node --test` through
    // the strip-types loader. Their bodies are largely file-content
    // matchers and synthetic assertions that don't benefit from full
    // strict mode. The runtime loader still type-strips the file so
    // any syntax errors surface at build time; this just relaxes the
    // semantic checks.
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  }
}
