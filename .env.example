# MiniMax local proxy configuration
# Copy this file to ".env" at the repo root and fill in real values.
# All variables also work as plain environment variables.

# Required: your MiniMax API key
MINIMAX_API_KEY=

# Optional overrides (defaults shown)
# MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
# MINIMAX_MODEL=MiniMax-M3
# MINIMAX_PORT=8001
# MINIMAX_HOST=127.0.0.1
# MINIMAX_TIMEOUT=60
# MINIMAX_LOG_LEVEL=INFO